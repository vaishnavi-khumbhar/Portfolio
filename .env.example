# Copy to .env (never commit real secrets; these values are public in the built site).

# Public URL of the deployed site, used for Open Graph / share previews.
VITE_SITE_URL=https://your-domain.com

# Optional: Formspree (or similar) endpoint so the contact form delivers directly.
# Leave empty to use the "open my email app" fallback.
VITE_FORM_ENDPOINT=

# Optional: only for GitHub Pages project sites, e.g. /my-repo-name/
VITE_BASE=
